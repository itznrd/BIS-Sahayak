# Retrieval mode: vector (hosted embeddings) or tfidf (offline fallback)
RETRIEVER=vector

# Embedding provider: jina, voyage, cohere, openai_compatible
RETRIEVER=vector
EMBED_PROVIDER=jina
EMBED_API_KEY=jina_api_key
EMBED_MODEL=jina-embeddings-v5-omni-small

# Answer generation - free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Production: comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000
